# Backend base URL (no trailing slash). Set in Azure Static Web Apps / CI as build-time env.
VITE_API_URL=http://localhost:5000
## trigger redeploy

# Subdirectory hosting (e.g. https://henrysaas.com/hms1/). Must start with / and usually end with /
# VITE_BASE_PATH=/hms1/

# Set to false to test real sign-in during npm run dev (default dev = open workspace without login).
# VITE_BYPASS_AUTH=false

# Staging / non-local: optional default tenant. On localhost, use `?tenant=harland` in the URL only (VITE_TENANT_SLUG is ignored locally).
# VITE_TENANT_SLUG=harland

# Dev: same-origin /api is proxied to the backend. Use only if the API is not on 127.0.0.1:5000.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000
# Set to `true` to call VITE_API_URL (or :5000) from the browser instead of the proxy (CORS must allow the dev origin + port).
# VITE_API_DIRECT=true

# Optional client-side preview gate (password is embedded in the built JS — not real security).
# Leave unset or empty to disable. For Azure SWA, set GitHub secret VITE_SITE_GATE_PASSWORD and pass it in the workflow env.
# VITE_SITE_GATE_PASSWORD=
