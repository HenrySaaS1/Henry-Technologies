# Copy to backend/.env.postgres (gitignored), for: npm run db:deploy:remote
# Supabase pooled (6543): set DATABASE_URL to pool URI and DIRECT_URL to “Direct connection” (5432).
DATABASE_URL="postgresql://postgres.USER:PASSWORD@POOLER.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
