PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Local dev without PostgreSQL (easiest on Windows) ---
# DATABASE_URL="file:./dev.db"
# Do NOT run: npx prisma migrate deploy  (that uses the PostgreSQL schema; it will error on file: URLs)
# Use instead:  npm run db:generate   then   npm run db:sqlite
# (npm install / postinstall runs db:generate from DATABASE_URL; stop dev server if Windows EPERM on Prisma DLL)

# --- PostgreSQL (Neon, Docker, or native install) ---
# DATABASE_URL="postgresql://henry:henry@localhost:5432/henry?schema=public"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --- Supabase (Postgres) — use this in production/staging with Prisma: set DATABASE_URL, then npm run db:generate && npm run db:deploy:postgres
# Get URI from Supabase → Project Settings → Database → Connection string. Prefer sslmode=require.
# For Prisma + PgBouncer, see: https://www.prisma.io/docs/orm/overview/databases/supabase
# Pooler (runtime queries, often :6543) + Direct (required for prisma migrate deploy on App Service startup).
# If Postgres logs show "prepared statement ... does not exist" (Supavisor / transaction pooler), add pgbouncer=true:
# DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Or use Supabase "Session mode" pooler URI for Prisma instead of Transaction mode (:6543).
# DIRECT_URL="postgresql://postgres.[project-ref]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Migrate Supabase/production Postgres without swapping local SQLite: copy .env.postgres.example → .env.postgres (gitignored),
# paste URI(s) there, then: npm run db:deploy:remote

DATABASE_URL="file:./dev.db"

# Azure Database for PostgreSQL Flexible Server (SSL required in connection string):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/DATABASE?sslmode=require"

# Required in production — use a long random string
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Azure: set CORS_ORIGIN to your Static Web App URL, e.g. https://your-app.azurestaticapps.net
# App Service sets PORT automatically on Linux — you usually omit PORT in Azure Configuration.
# `npm start` runs `prisma migrate deploy` then the API.

# Contact form email notifications (optional but recommended)
# CONTACT_NOTIFICATION_TO can be one address or comma-separated addresses
CONTACT_NOTIFICATION_TO=info@goaskhenry.com

# SMTP settings for sending contact form emails
# Example: smtp.zoho.com (port 465 secure=true, or 587 secure=false)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional explicit From address shown in inbox
SMTP_FROM=
