generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  company               String
  slug                  String    @default("generic")
  dashboardPreset       String?
  planId                String?
  productIds            String // JSON array of product id strings
  lastLoginAt           DateTime?
  onboardingData        Json?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  contacts              Contact[]
  authEvents            AuthEvent[]
}

model Contact {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  email       String
  companyName String?
  interest    String?
  notes       String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuthEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  eventType  String
  email      String
  success    Boolean
  message    String?
  ip         String?
  userAgent  String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([email, createdAt])
}
